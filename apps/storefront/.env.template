# Copy to .env.local and fill in. Never commit .env.local.

# Publishable API key from the Medusa admin (Settings > Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region (ISO-2 country code that exists in a Medusa region)
NEXT_PUBLIC_DEFAULT_REGION=kw

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key (optional)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket (optional)
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=


# Deema instalment widget on product pages (Deema requires it before go-live).
# Public widget key from Deema's merchant portal; leave empty to load nothing.
NEXT_PUBLIC_DEEMA_WIDGET_KEY=
# https://sandbox-widget.deema.me (sandbox, default) or https://widget.deema.me
NEXT_PUBLIC_DEEMA_WIDGET_URL=
