# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eco
DB_NAME=eco

# Optional in development, required in production. Enables shared caching,
# event bus, workflow engine, and locking.
REDIS_URL=redis://localhost:6379

# Comma-separated origins allowed to call each API group. In production list
# only your real domains.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Generate each with: openssl rand -hex 32
# The server refuses to start in production with weak or placeholder values.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# Search. Unset = Medusa's built-in Postgres search. Set to use Meilisearch
# (Arabic tokenization, typo tolerance, Gulf/English synonyms). Use a key with
# only the rights the backend needs, not the master key, in production.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_PREFIX=

# Public storefront URL, used for product links in the Google Merchant feeds
# (/feeds/google/ar and /feeds/google/en)
STOREFRONT_URL=http://localhost:8000

# Public URL of this backend (used by the admin dashboard)
MEDUSA_BACKEND_URL=http://localhost:9000

# shared | server | worker
MEDUSA_WORKER_MODE=shared

# Uploaded files: Cloudflare R2 / S3 when S3_BUCKET is set, otherwise the
# server's ./static directory (a persistent volume in Docker).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
DISABLE_MEDUSA_ADMIN=false

# Payments. Each gateway is enabled only when its keys are set. Webhook URLs
# to give the gateways: {MEDUSA_BACKEND_URL}/hooks/payment/<provider>, e.g.
# /hooks/payment/klickpay_knet, /hooks/payment/taly_taly, /hooks/payment/deema_deema.
# STOREFRONT_URL (comma-separated if several) limits where customers return.
#
# KlickPay: KNET, Visa/Mastercard (MPGS), Apple/Google/Samsung Pay.
# Staging is the default; set KLICKPAY_BASE_URL only once KlickPay confirms
# the production URL in writing.
KLICKPAY_CLIENT_ID=
KLICKPAY_CLIENT_SECRET=
KLICKPAY_WEBHOOK_SECRET=
KLICKPAY_BASE_URL=
# Any of: knet, card, apple_pay, google_pay, samsung_pay
KLICKPAY_METHODS=knet,card,apple_pay
#
# Taly (pay in 3/4). Credentials from Taly's partner portal (Keys tab).
# Sandbox: https://api.dev-taly.io (default). Production URL comes from Taly.
TALY_USERNAME=
TALY_PASSWORD=
TALY_BASE_URL=
#
# Deema (BNPL). API key from merchant.deema.me (sandbox-merchant for testing).
# Production: https://api.deema.me/api/merchant/v1
DEEMA_API_KEY=
DEEMA_BASE_URL=
# The custom header you set for webhooks in Deema's portal, and its value.
DEEMA_WEBHOOK_HEADER=x-deema-signature
DEEMA_WEBHOOK_SECRET=

# Keys entered in the admin (Settings > Integrations) are encrypted with
# this. Falls back to QUICKBOOKS_ENCRYPTION_KEY. Never change it once keys
# are saved: they could no longer be read. openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# QuickBooks Online (optional). Create an app at developer.intuit.com
# (Accounting scope) and add this redirect URI to it:
#   {MEDUSA_BACKEND_URL}/quickbooks/callback
# Then connect from the admin: Settings > QuickBooks. See docs/QUICKBOOKS.md.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox | production
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=
# Encrypts the stored OAuth tokens. openssl rand -hex 32. Changing it
# means reconnecting.
QUICKBOOKS_ENCRYPTION_KEY=
