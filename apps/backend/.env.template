# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eco
DB_NAME=eco

# Optional in development, required in production. Enables shared caching,
# event bus, workflow engine, and locking.
REDIS_URL=redis://localhost:6379

# Comma-separated origins allowed to call each API group. In production list
# only your real domains.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Generate each with: openssl rand -hex 32
# The server refuses to start in production with weak or placeholder values.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# Search. Unset = Medusa's built-in Postgres search. Set to use Meilisearch
# (Arabic tokenization, typo tolerance, Gulf/English synonyms). Use a key with
# only the rights the backend needs, not the master key, in production.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_PREFIX=

# Public storefront URL, used for product links in the Google Merchant feeds
# (/feeds/google/ar and /feeds/google/en)
STOREFRONT_URL=http://localhost:8000

# Public URL of this backend (used by the admin dashboard)
MEDUSA_BACKEND_URL=http://localhost:9000

# shared | server | worker
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
