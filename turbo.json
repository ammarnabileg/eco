{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".medusa/server/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "passThroughEnv": [
        "MEILISEARCH_TEST_HOST",
        "MEILISEARCH_TEST_API_KEY",
        "DB_HOST",
        "DB_USERNAME",
        "DB_PASSWORD"
      ]
    }
  }
}
